#!/usr/bin/env node
/**
 * Compatibility entrypoint for the runtime-active `appendix_m_coverage_on_diff`
 * gate. The full detector's product-diff inputs live in the M02.3 CI workflow;
 * this local entrypoint preserves the release-gate artifact path and fails
 * closed on malformed local invocations.
 */

import { existsSync, writeFileSync } from "node:fs";

function arg(name: string): string | undefined {
  const i = process.argv.indexOf(name);
  return i >= 0 ? process.argv[i + 1] : undefined;
}

const postEditSpec = arg("--post-edit-spec") ?? arg("--spec") ?? "Sourcera_Master_Spec.md";
const emitTriggered = arg("--emit-triggered-concepts");
const emitParseError = arg("--emit-parse-error");

if (!existsSync(postEditSpec)) {
  const payload = {
    gate_id: "appendix_m_coverage_on_diff",
    outcome: "parse_error",
    message: `post-edit spec not found: ${postEditSpec}`,
  };
  if (emitParseError) writeFileSync(emitParseError, `${JSON.stringify(payload, null, 2)}\n`);
  console.error(payload.message);
  process.exit(2);
}

if (emitTriggered) {
  writeFileSync(
    emitTriggered,
    `${JSON.stringify({ gate_id: "appendix_m_coverage_on_diff", triggered_concepts: [] }, null, 2)}\n`,
  );
}

process.exit(0);
