/**
 * Sourcera Spec-Lint Harness — gate runner, CLI, fixture mode, and reusable
 * detector factories.
 *
 * Authority anchor: Sourcera_Master_Spec.md §M.4.3 (failure mode + fail-closed
 * exit codes), §M.4.4 (override application), §M.5.2 (override classes).
 *
 * Each gate file in `gates/` imports `runGateCli(gate)` and calls it at module
 * bottom guarded by `isEntrypoint()`, so the file is directly runnable as
 * `npx tsx tools/spec-lint/gates/<gate>.ts --spec Sourcera_Master_Spec.md`,
 * matching the per-detector invocation convention in `.github/workflows/spec-lint.yml`.
 */

import { fileURLToPath, pathToFileURL } from "node:url";
import { existsSync } from "node:fs";
import { dirname, join } from "node:path";
import type {
  Finding,
  GateContext,
  GateResult,
  SpecLintGate,
} from "./types.js";
import { EXIT_CODE } from "./types.js";
import {
  loadDoc,
  computeSectionRanges,
  anchorForLine,
  fenceMask,
} from "./spec_loader.js";
import { parseOverrides, admitsOverride } from "./overrides.js";
import { emit } from "./emit.js";
import type { SpecDoc } from "./types.js";

const DETECTOR_VERSION_DEFAULT = "1.0.0";

export interface CliArgs {
  spec: string;
  ux?: string;
  reconciliation?: string;
  aeLedger?: string;
  buyerPricing?: string;
  sellerPricing?: string;
  prBody?: string;
  /** Run against a single fixture file as the master spec (test harness). */
  fixture?: string;
  emitResult?: string;
  /** When set, skip the §M.4.5 audit emit (pure local run). */
  noEmit?: boolean;
  extra: Record<string, string>;
}

export function parseArgv(argv: string[]): CliArgs {
  const args: CliArgs = { spec: "Sourcera_Master_Spec.md", extra: {} };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    const next = () => argv[++i];
    switch (a) {
      case "--spec":
        args.spec = next();
        break;
      case "--ux":
        args.ux = next();
        break;
      case "--reconciliation":
        args.reconciliation = next();
        break;
      case "--ae-ledger":
        args.aeLedger = next();
        break;
      case "--buyer-pricing":
        args.buyerPricing = next();
        break;
      case "--seller-pricing":
        args.sellerPricing = next();
        break;
      case "--pr-body":
        args.prBody = next();
        break;
      case "--fixture":
        args.fixture = next();
        break;
      case "--emit-result":
        args.emitResult = next();
        break;
      case "--no-emit":
        args.noEmit = true;
        break;
      default:
        if (a.startsWith("--")) args.extra[a.slice(2)] = next();
    }
  }
  return args;
}

/**
 * Assemble the GateContext from CLI args. In fixture mode the fixture file is
 * loaded as the master spec (and, when the gate needs a UX doc, also as the UX
 * doc) so a self-contained fixture can exercise the rule in isolation.
 */
export function buildContext(gate: SpecLintGate, args: CliArgs): GateContext {
  const masterPath = args.fixture ?? args.spec;
  const masterSpec = loadDoc(masterPath);

  let uxSpec: SpecDoc | undefined;
  if (gate.inputs.uxSpec) {
    const uxPath = args.fixture ?? args.ux;
    if (uxPath && existsSync(uxPath)) uxSpec = loadDoc(uxPath);
  }
  let reconciliation: SpecDoc | undefined;
  if (gate.inputs.reconciliation && args.reconciliation) {
    if (existsSync(args.reconciliation))
      reconciliation = loadDoc(args.reconciliation);
  }
  const extraDocs = new Map<string, SpecDoc>();
  if (gate.inputs.aeLedger) {
    const aePath = args.fixture ?? args.aeLedger ?? "_integration/AUTHORED_EXTENSIONS_LEDGER.md";
    if (existsSync(aePath)) extraDocs.set("aeLedger", loadDoc(aePath));
  }
  if (gate.inputs.buyerPricing) {
    const buyerPath = args.fixture ?? args.buyerPricing ?? join(dirname(masterPath), "Sourcera_Buyer_Pricing_Strategy.md");
    if (existsSync(buyerPath)) extraDocs.set("buyerPricing", loadDoc(buyerPath));
  }
  if (gate.inputs.sellerPricing) {
    const sellerPath = args.fixture ?? args.sellerPricing ?? join(dirname(masterPath), "Sourcera_Seller_Pricing_Strategy.md");
    if (existsSync(sellerPath)) extraDocs.set("sellerPricing", loadDoc(sellerPath));
  }

  const prBody = readPrBody(args.prBody);
  const overrides = admitsOverride(gate.overridePath)
    ? parseOverrides(prBody, { knownGateIds: new Set([gate.id]) })
    : parseOverrides(prBody, { notPermittedGates: new Set([gate.id]) });

  return {
    masterSpec,
    uxSpec,
    reconciliation,
    overrides,
    extraDocs,
  };
}

function readPrBody(path?: string): string {
  if (!path) return process.env.PR_BODY ?? "";
  try {
    return existsSync(path) ? loadDoc(path).text : "";
  } catch {
    return "";
  }
}

/** Run a gate to a structured GateResult (no emit, no exit). */
export function runGate(gate: SpecLintGate, ctx: GateContext): GateResult {
  let findings: Finding[] = [];
  let parseError = false;
  try {
    findings = gate.run(ctx);
  } catch (err) {
    parseError = true;
    findings = [
      {
        file: ctx.masterSpec.path,
        line: 0,
        message: `parse_error: ${(err as Error).message}`,
      },
    ];
  }

  // Apply overrides (§M.4.4) only for gates whose Override path admits them.
  let overrideApplied = false;
  if (!parseError && admitsOverride(gate.overridePath)) {
    const ov = ctx.overrides.get(gate.id);
    if (ov && !ov.grammar_error) {
      findings = findings.map((f) => ({
        ...f,
        suppressed_by_override: ov.rationale,
      }));
      if (findings.length > 0) overrideApplied = true;
    }
  }

  const liveFindings = findings.filter((f) => !f.suppressed_by_override);
  const outcome = parseError
    ? "parse_error"
    : liveFindings.length > 0
      ? "fail"
      : overrideApplied
        ? "override_applied"
        : "pass";

  return {
    gate_id: gate.id,
    outcome,
    findings,
    scanned_files: scannedFiles(ctx),
    stats: {
      finding_count: liveFindings.length,
      suppressed_count: findings.length - liveFindings.length,
    },
    detector_version: gate.version || DETECTOR_VERSION_DEFAULT,
    ran_at_utc: new Date().toISOString(),
  };
}

function scannedFiles(ctx: GateContext): string[] {
  const f = [ctx.masterSpec.path];
  if (ctx.uxSpec) f.push(ctx.uxSpec.path);
  if (ctx.reconciliation) f.push(ctx.reconciliation.path);
  for (const doc of ctx.extraDocs.values()) f.push(doc.path);
  return f;
}

/** Full CLI entrypoint: parse args, run, emit, print JSON, set exit code. */
export async function runGateCli(gate: SpecLintGate): Promise<void> {
  const args = parseArgv(process.argv.slice(2));
  const ctx = buildContext(gate, args);
  const result = runGate(gate, ctx);

  if (!args.noEmit) {
    try {
      const report = await emit(result, {
        prId: process.env.PR_ID,
        commitSha: process.env.COMMIT_SHA,
        mergeBaseSha: process.env.MERGE_BASE_SHA,
        gateRunId: process.env.GATE_RUN_ID,
      });
      (result.stats as Record<string, string>).run_log = report.run_log_path;
    } catch (e) {
      // Audit emit must never mask the gate verdict; record and continue.
      (result.stats as Record<string, string>).emit_error = (e as Error).message;
    }
  }

  const json = JSON.stringify(result, null, 2);
  process.stdout.write(json + "\n");
  if (args.emitResult) {
    const { writeFileSync } = await import("node:fs");
    writeFileSync(args.emitResult, json + "\n", "utf-8");
  }
  process.exitCode = EXIT_CODE[result.outcome];
}

/** True when this module is the process entrypoint (tsx/ESM-safe). */
export function isEntrypoint(importMetaUrl: string): boolean {
  const entry = process.argv[1];
  if (!entry) return false;
  try {
    return pathToFileURL(entry).href === importMetaUrl;
  } catch {
    return fileURLToPath(importMetaUrl) === entry;
  }
}

// ---------------------------------------------------------------------------
// Reusable detector factories (archetype kernels).
// ---------------------------------------------------------------------------

export interface SingletonGateSpec {
  id: string;
  sourcePhase: string;
  version: string;
  /** OverridePath; numerical singletons are typically not_permitted_billing_singleton. */
  overridePath: SpecLintGate["overridePath"];
  /** Patterns whose matches are the "value" that must live only in allowed homes. */
  valuePatterns: RegExp[];
  /**
   * Predicate: is a given line within an authoritative home for the value?
   * Receives the line text, line number, and the nearest section anchor/title.
   */
  isAllowedHome(line: string, lineNo: number, sectionTitle: string): boolean;
  /** Human label for the value class, used in finding messages. */
  valueLabel: string;
  /**
   * Optional: allow-list a matched substring as exempt (e.g., a template token
   * permitted in a broader section set than the literal value). Receives the
   * matched text, the full line, and the nearest enclosing section title.
   */
  isExemptMatch?(matchText: string, line: string, sectionTitle: string): boolean;
}

/**
 * Build a numerical-singleton gate: the configured value patterns may appear
 * ONLY in lines for which `isAllowedHome` returns true. Restatements elsewhere
 * are findings. Demonstrated reuse: `solo_tier_numeric_single_source` and
 * `retention_singleton_section_40_2_canonical` are both instances of this
 * factory (Authoring Convention #10 — numerical singletons).
 */
export function makeSingletonGate(spec: SingletonGateSpec): SpecLintGate {
  return {
    id: spec.id,
    sourcePhase: spec.sourcePhase,
    rowClass: "spec_tree_lint",
    executionContext: "pr_lint",
    overridePath: spec.overridePath,
    inputs: { masterSpec: true },
    version: spec.version,
    run(ctx: GateContext): Finding[] {
      const doc = ctx.masterSpec;
      const mask = fenceMask(doc);
      const findings: Finding[] = [];
      const sectionTitleAt = sectionTitleResolver(doc);
      for (let i = 1; i < doc.lines.length; i++) {
        if (mask[i]) continue;
        const line = doc.lines[i];
        const title = sectionTitleAt(i);
        if (spec.isAllowedHome(line, i, title)) continue;
        for (const re of spec.valuePatterns) {
          re.lastIndex = 0;
          let m: RegExpExecArray | null;
          while ((m = re.exec(line)) !== null) {
            if (spec.isExemptMatch?.(m[0], line, title)) continue;
            findings.push({
              file: doc.path,
              line: i,
              anchor: anchorForLine(doc, i),
              matched_text: m[0],
              message: `${spec.valueLabel} restated outside its authoritative home; cite the canonical table instead (Authoring Convention #10).`,
            });
            if (!re.global) break;
          }
        }
      }
      return findings;
    },
  };
}

/** Resolve the nearest enclosing heading title for any line (cached). */
export function sectionTitleResolver(doc: SpecDoc): (line: number) => string {
  const ranges = computeSectionRanges(doc);
  // Build a sorted list of (startLine, title) and binary-search per query.
  const starts = ranges.map((r) => r.startLine);
  return (line: number) => {
    let lo = 0,
      hi = ranges.length - 1,
      best = -1;
    while (lo <= hi) {
      const mid = (lo + hi) >> 1;
      if (starts[mid] <= line) {
        best = mid;
        lo = mid + 1;
      } else hi = mid - 1;
    }
    return best >= 0 ? ranges[best].heading.title : "";
  };
}
