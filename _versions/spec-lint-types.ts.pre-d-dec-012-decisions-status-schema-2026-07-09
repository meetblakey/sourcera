/**
 * Sourcera Spec-Lint Harness — shared types.
 *
 * Authority anchor: Sourcera_Master_Spec.md §M.4 (CI gate enforcement contract),
 * §M.4.5.1 (AuditEvent record schema), §M.5.3 (catalog row schema).
 *
 * This module is the type spine for the reusable spec-lint detector harness
 * landed in implementation pack M02.3 (per `Build_Execution_Strategy.md` §11)
 * during the v7.2.0-REM M02.3 Runtime-Wiring pass (2026-06-15). It generalizes
 * the single-detector pattern previously established by
 * `tools/spec-lint/appendix_k_canonicality.ts` into a framework that every
 * spec-tree-lint gate in the §M.5.4 catalog can be built against.
 *
 * SCOPE BOUNDARY (honesty contract): this harness scans markdown documents that
 * physically exist in the spec repository (`Sourcera_Master_Spec.md`,
 * `UX_Design_of_Sourcera.md`, the appendices, and the `_integration/` ledgers).
 * It is NOT a substitute for the product-codebase static-analysis gates
 * (Convex serializers, GraphQL/REST handlers, RBAC enum declarations, MFA code
 * paths, the DSAR cascade-walker, the EvalStarter registry). Those gates are
 * `spec_binding_pending_pack_m02_3` until the product repo's M02.3 pack ships
 * them; see `_integration/M02_3_RUNTIME_WIRING_PLAN.md` for the classification.
 */

/**
 * §M.5.3 `Runtime status` enum (registered in Appendix J as
 * `ci_gate_runtime_status`). The harness only ever produces detectors that can
 * legitimately carry `runtime_active`; the `spec_binding_*` variants are
 * documentary.
 */
export type RuntimeStatus =
  | "runtime_active"
  | `spec_binding_pending_pack_${string}`
  | "spec_binding_release_gate_only";

/**
 * §M.5.3 `Execution context` enum (registered in Appendix J as
 * `ci_gate_execution_context`). Spec-tree-lint detectors run in `pr_lint`.
 */
export type ExecutionContext =
  | "pr_lint"
  | "post-build"
  | "github_actions + post-build"
  | "deploy_validator"
  | "runtime_test"
  | "synthetic_monitor"
  | "quarterly_chaos"
  | "release_stamp"
  | "nightly_cron";

/**
 * §M.5.3 `Row class` enum (registered in Appendix J as `ci_gate_row_class`).
 */
export type RowClass =
  | "per_feature_gate"
  | "cross_feature_invariant"
  | "spec_tree_lint"
  | "api_contract_completeness"
  | "catalog_consistency"
  | "content_consistency"
  | "data_model_contract"
  | "enum_consistency"
  | "audit_registry_consistency"
  | "mobile_parity_consistency"
  | "numerical_singleton_invariant"
  | "webhook_catalog_consistency"
  | "runtime_property_test"
  | "synthetic_monitor"
  | "deploy_validator"
  | "chaos_synthetic"
  | "release_stamp_gate"
  | "meta_catalog_invariant";

/**
 * Override class taxonomy per §M.5.2 / §M.4.4.5. `not_permitted` and its typed
 * siblings reject any override annotation; `default_ci_gate_override` admits a
 * `@ci-gate-override:` annotation with a ≥60-char rationale.
 */
export type OverridePath =
  | "default_ci_gate_override"
  | "not_permitted"
  | "not_permitted_billing_singleton"
  | "not_permitted_refund_threshold_drift"
  | "not_permitted_entitlement_drift"
  | "not_permitted_gdpr_art_17"
  | "not_permitted_article_22"
  | "not_permitted_console_firewall"
  | "not_permitted_audit_log_integrity"
  | "not_permitted_catalog_completeness"
  | "not_permitted_retry_class_binding"
  | "not_permitted_accessibility_conformance"
  | "not_permitted_score_math_integrity"
  | "not_permitted_seller_pulse_firewall_integrity"
  | "appendix_m_internal_only"; // §M.4.4 Appendix-M-coverage-specific path

/**
 * Gate outcome. Superset of the §M.4.5.1 `gate_outcome` enum, generalized for
 * spec-tree-lint gates. `pass`/`fail`/`parse_error` are the exit-code carriers;
 * `override_applied` records a deliberate, validated override.
 */
export type GateOutcome = "pass" | "fail" | "override_applied" | "parse_error";

/** Exit codes are fail-closed per §M.4.3 (parse_error is non-overridable). */
export const EXIT_CODE: Record<GateOutcome, number> = {
  pass: 0,
  override_applied: 0,
  fail: 1,
  parse_error: 2,
};

/** A single rule violation found by a detector. */
export interface Finding {
  /** Path of the document the violation was found in. */
  file: string;
  /** 1-based line number. */
  line: number;
  /** Nearest enclosing spec anchor/section, when resolvable. */
  anchor?: string;
  /** The offending substring (truncated for the audit record). */
  matched_text?: string;
  /** Human-readable explanation surfaced in the inline PR review comment. */
  message: string;
  /**
   * If an override annotation was matched against this finding, the rationale
   * that suppressed it (only set when the gate's OverridePath admits overrides).
   */
  suppressed_by_override?: string;
}

/** Document loaded by the spec_loader. */
export interface SpecDoc {
  path: string;
  text: string;
  /** 1-indexed access: lines[1] is the first line. lines[0] is "". */
  lines: string[];
}

/** Inputs handed to a gate's `run()`. */
export interface GateContext {
  /** Primary Master Spec document (always present). */
  masterSpec: SpecDoc;
  /** UX design spec (present only for multi-file gates). */
  uxSpec?: SpecDoc;
  /** RECONCILIATION.md (present for ledger-scoped gates). */
  reconciliation?: SpecDoc;
  /** Parsed override annotations from the PR body, keyed by gate id. */
  overrides: Map<string, ParsedOverride>;
  /** Arbitrary extra docs keyed by a short name (e.g., "aeLedger"). */
  extraDocs: Map<string, SpecDoc>;
}

/** Result of one detector run; serialized to the §M.4.5 audit trail. */
export interface GateResult {
  gate_id: string;
  outcome: GateOutcome;
  findings: Finding[];
  /** Files actually scanned (for audit transparency). */
  scanned_files: string[];
  /** Free-form per-gate statistics (counts, thresholds) for the digest. */
  stats: Record<string, number | string>;
  detector_version: string;
  ran_at_utc: string;
}

/** A parsed `@ci-gate-override:` or `@appendix-m-internal-only:` annotation. */
export interface ParsedOverride {
  gate_id: string;
  rationale: string;
  qualifiers: string[];
  /** Set when the annotation failed grammar validation (§M.4.4.1 / §M.4.4.5). */
  grammar_error?:
    | "override_rationale_too_short"
    | "override_unknown_gate"
    | "ci_gate_override_not_permitted";
}

/** Static descriptor + behavior for one detector. */
export interface SpecLintGate {
  /** §M.5.4 Gate ID (ASCII snake_case; unique across catalog). */
  id: string;
  /** §M.5.4 Source phase. */
  sourcePhase: string;
  rowClass: RowClass;
  executionContext: ExecutionContext;
  overridePath: OverridePath;
  /** Which docs the detector needs loaded. */
  inputs: {
    masterSpec: boolean;
    uxSpec?: boolean;
    reconciliation?: boolean;
    aeLedger?: boolean;
    buyerPricing?: boolean;
    sellerPricing?: boolean;
  };
  /** Detector semver; bumped on logic changes (audit-record field). */
  version: string;
  /** Pure detector: produce findings from the loaded context. */
  run(ctx: GateContext): Finding[];
}

/** Minimum rationale length for any `@ci-gate-override:` per §M.4.4.5 ¶1. */
export const OVERRIDE_RATIONALE_MIN_CHARS = 60;
