{
  "name": "@sourcera/marketplace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "next build",
    "build:all": "npm run build && npm run build --workspace @sourcera/buyer && npm run build --workspace @sourcera/seller",
    "dev": "next dev",
    "lint": "eslint . --max-warnings=0",
    "start": "next start",
    "test": "tsx --test tests/**/*.spec.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "npm run typecheck && npm run typecheck --workspace @sourcera/buyer && npm run typecheck --workspace @sourcera/seller",
    "validate:boundaries": "tsx scripts/validate-domain-boundaries.ts",
    "validate:deploy": "tsx scripts/validate-deploy-env.ts --domain marketplace",
    "vercel-build": "npm run validate:deploy && npm run build",
    "verify": "npm run lint && npm run validate:boundaries && npm run typecheck:all && npm test && npm run build:all"
  },
  "dependencies": {
    "@sourcera/domain": "0.1.0",
    "@base-ui/react": "1.6.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "geist": "1.7.2",
    "lucide-react": "1.24.0",
    "next": "16.2.10",
    "pino": "10.3.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "4.3.2",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
